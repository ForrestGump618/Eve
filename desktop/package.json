{
  "name": "eve-desktop",
  "version": "1.2.0",
  "private": true,
  "description": "Eve research workspace with durable local and SSH task execution",
  "main": "dist/main.js",
  "type": "module",
  "author": "Eve contributors",
  "license": "MIT",
  "scripts": {
    "build": "tsc && node scripts/copy-assets.mjs",
    "start": "electron .",
    "test": "npm run build && node --test dist/test/*.test.js",
    "dist:win": "npm run build && electron-builder --win nsis --x64",
    "pack": "npm run build && electron-builder --dir",
    "sbom": "node -e \"import('node:fs').then(({mkdirSync})=>mkdirSync('release',{recursive:true}))\" && npm sbom --package-lock-only --sbom-format cyclonedx --sbom-type application > release/sbom.cdx.json",
    "smoke": "node scripts/electron-smoke.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:integration": "node scripts/e2e-rpc.mjs --live",
    "test:harness": "node scripts/harness-benchmark.mjs"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "js-tiktoken": "1.0.21"
  },
  "devDependencies": {
    "@types/node": "24.12.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "katex": "^0.16.21",
    "mermaid": "^11.12.0",
    "playwright-core": "1.64.1",
    "typescript": "7.0.2"
  },
  "build": {
    "appId": "org.eve.research.desktop",
    "productName": "Eve",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "artifactName": "Eve-Setup-${version}-win-${arch}.${ext}",
    "files": [
      "dist/main.js",
      "dist/build-info.json",
      "dist/src/**/*",
      "dist/ui/**/*",
      "dist/bundled-skills/**/*",
      "package.json",
      "LICENSE",
      "NOTICE",
      "third-party-licenses/**/*",
      "dist/skill-library/**/*"
    ],
    "extraResources": [
      {
        "from": "worker",
        "to": "worker",
        "filter": [
          "*.py"
        ]
      },
      {
        "from": "..",
        "to": "legacy",
        "filter": [
          "omicslab/**/*.py",
          "omicslab/web/**/*",
          "omicslab/skills/**/*",
          "omicslab/agents/**/*",
          "omicslab/data/**/*",
          "tests/test_skills.py",
          "tests/test_tools.py",
          "tests/test_turn_governance.py",
          "pyproject.toml",
          "LICENSE",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      },
      {
        "from": "assets/eve.ico",
        "to": "eve.ico"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signExecutable": false,
      "icon": "assets/eve.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "Eve",
      "uninstallDisplayName": "Eve"
    }
  }
}

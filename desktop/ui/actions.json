  },
  {
    "id": "auto-conversation-get",
    "selector": "#sessions button.session",
    "page": "chat",
    "method": "conversation.get",
    "params": {
      "id": "<conversationId>"
    },
    "notes": "Opening a session tries the stored conversation record; task-derived history is the fallback."
  },
  {
    "id": "auto-conversation-append",
    "selector": "#timeline",
    "page": "chat",

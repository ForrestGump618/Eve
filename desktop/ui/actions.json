    "params": {
      "title": "<prompt slice>",
      "projectId": "<session filter project or null>",
      "mode": "<auto|chat|research|debate|autonomy>"
    },
    "notes": "Lazily creates the conversation record on first send; failure falls back to a local id and shows a notice (never silently fakes persistence)."
  },

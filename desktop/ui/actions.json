  {
    "id": "auto-stream-replay",
    "selector": "#timeline",
    "page": "chat",
    "method": "events.replay",
    "params": {
      "since": "number (last applied global event sequence)",
      "limit": "number (bounded by the main process, 2000 max)"
    },
    "notes": "Main-process bridge (events.stream itself is main-only): one replay request per detected envelope-sequence gap, applied through the same pure stream reducer, never rendered out of order."
  },
  {
    "id": "auto-health",
